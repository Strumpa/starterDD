# Ignore the __pycache__ directory
./__pycache__

# Ignore specific directories
*venv/
docs/_build
build
# ignore .out files used to test the output of the test functions
*.out

# Ignore other common Python artifacts
*.pyc
*.pyo
*.pyd
*.pdb
*.egg
*.egg-info/

tutorials/__pycache__/
tutorials/results/

tests/outputs

# Local-only data: GE14 full samples and other large results (never committed)
temp_examples/

# HDF5 caches of DRAGON COMPOs written next to the ASCII files by CompoReader
_CPO_*.h5

# Machine-specific paths (cluster accounts, local folders): never committed.
# Per-study overlays next to a study file; the site file lives outside the repo
# (~/.config/starterDD/site.yaml, template docs/site.example.yaml).
*.local.yaml
site.yaml
